// EXPERIMENTAL: 3x3 convolution with NVIDIA cooperative matrices 2 (VK_NV_cooperative_matrix2)
//
// Written in GLSL because Slang's tensor addressing loads/stores currently require descriptor-bound
// buffers, while vk_oidn accesses all memory through buffer device addresses.
//
// Each workgroup computes a segment of BM pixels of one output row for BN output channels, as a
// single workgroup-scope accumulator matrix. The A matrices (BM pixels x BK input channels) are
// loaded directly from the input rows with tensor addressing: pixels outside the image are clamped
// to zero, which implements the convolution padding without any shared memory staging (the
// driver handles the data distribution). Upsampling and pooling are not supported yet.
//
// Weights: [tap][K = all padded input channels][N = padded output channels] f16 (row-major)
// Bias: [N] f32 (loaded as a matrix with clamp-to-edge, which replicates it in all rows)

#version 460
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_NV_cooperative_matrix2 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_control_flow_attributes : require

#if !defined(OIDN_NO_FLOAT_CONTROLS)
  #extension GL_EXT_spirv_intrinsics : require
  spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4467], 4462, 16); // RoundingModeRTE
  spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4464], 4459, 16); // DenormPreserve
#endif

layout(constant_id = 0) const uint WG_SIZE = 128;
layout(constant_id = 1) const bool UPSAMPLE = false; // not supported
layout(constant_id = 2) const bool POOL = false;     // not supported
layout(constant_id = 3) const bool RELU = true;
layout(constant_id = 4) const uint BM = 64; // pixels per workgroup (multiple of 32)
layout(constant_id = 5) const uint BN = 64; // output channels per workgroup (multiple of 16)
layout(constant_id = 6) const uint BK = 32; // input channels per step (multiple of 16)

layout(local_size_x_id = 0) in;

layout(buffer_reference, std430, buffer_reference_align = 16) buffer HalfBuf  { float16_t v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) buffer FloatBuf { float v[]; };

layout(push_constant, std430) uniform Params
{
  uint64_t src0;   // first source
  uint64_t src1;   // second source (concatenated, optional)
  uint64_t weight; // weights [tap][K][N]
  uint64_t bias;   // bias [N] f32
  uint64_t dst;    // destination
  int H;
  int W;
  int C0;
  int C1;
  int NB;
} p;

void main()
{
  const uint x0 = gl_WorkGroupID.x * BM;
  const int  y  = int(gl_WorkGroupID.y);
  const uint n0 = gl_WorkGroupID.z * BN;
  const uint N  = uint(p.NB) * 16u;
  const uint K  = uint(p.C0 + p.C1);

  tensorLayoutNV<2, gl_CooperativeMatrixClampModeConstantNV> layoutA =
    createTensorLayoutNV(2, gl_CooperativeMatrixClampModeConstantNV);
  tensorLayoutNV<2> layoutB = createTensorLayoutNV(2);
  layoutB = setTensorLayoutDimensionNV(layoutB, 9u * K, N);
  tensorLayoutNV<2, gl_CooperativeMatrixClampModeClampToEdgeNV> layoutBias =
    createTensorLayoutNV(2, gl_CooperativeMatrixClampModeClampToEdgeNV);
  layoutBias = setTensorLayoutDimensionNV(layoutBias, 1u, N);
  tensorLayoutNV<2, gl_CooperativeMatrixClampModeConstantNV> layoutD =
    createTensorLayoutNV(2, gl_CooperativeMatrixClampModeConstantNV);
  layoutD = setTensorLayoutDimensionNV(layoutD, uint(p.W), N);

  // Initialize the accumulator with the bias (the single bias row is replicated by clamping)
  coopmat<float, gl_ScopeWorkgroup, BM, BN, gl_MatrixUseAccumulator> acc;
  coopMatLoadTensorNV(acc, FloatBuf(p.bias).v, 0, sliceTensorLayoutNV(layoutBias, 0u, BM, n0, BN));

  for (int ky = 0; ky < 3; ++ky)
  {
    const int yy = y + ky - 1;
    if (yy < 0 || yy >= p.H)
      continue; // zero padding

    for (uint k = 0; k < K; k += BK)
    {
      const bool fromSrc0 = k < uint(p.C0);
      const uint C = fromSrc0 ? uint(p.C0) : uint(p.C1);
      const uint c = fromSrc0 ? k : k - uint(p.C0);
      HalfBuf row = HalfBuf((fromSrc0 ? p.src0 : p.src1) + uint64_t(yy) * uint64_t(p.W) * uint64_t(C) * 2ul);
      layoutA = setTensorLayoutDimensionNV(layoutA, uint(p.W), C);

      [[unroll]] for (int kx = 0; kx < 3; ++kx)
      {
        // Pixels x0 + kx - 1 ... (the offset wraps around for x = -1, which is clamped to zero)
        coopmat<float16_t, gl_ScopeWorkgroup, BM, BK, gl_MatrixUseA> a;
        coopMatLoadTensorNV(a, row.v, 0, sliceTensorLayoutNV(layoutA, x0 + uint(kx) - 1u, BM, c, BK));

        coopmat<float16_t, gl_ScopeWorkgroup, BK, BN, gl_MatrixUseB> b;
        coopMatLoadTensorNV(b, HalfBuf(p.weight).v, 0,
                            sliceTensorLayoutNV(layoutB, uint(ky * 3 + kx) * K + k, BK, n0, BN));

        acc = coopMatMulAdd(a, b, acc);
      }
    }
  }

  if (RELU)
  {
    for (int i = 0; i < acc.length(); ++i)
      acc[i] = max(acc[i], 0.);
  }

  coopmat<float16_t, gl_ScopeWorkgroup, BM, BN, gl_MatrixUseAccumulator> result =
    coopmat<float16_t, gl_ScopeWorkgroup, BM, BN, gl_MatrixUseAccumulator>(acc);
  coopMatStoreTensorNV(result, HalfBuf(p.dst + uint64_t(y) * uint64_t(p.W) * uint64_t(N) * 2ul).v, 0,
                       sliceTensorLayoutNV(layoutD, x0, BM, n0, BN));
}
